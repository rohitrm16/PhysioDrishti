# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real secrets.

# Supabase (public, used by browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase (server-side only — used by scripts/ingest.ts)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini (server-side only — used by scripts/ingest.ts)
GEMINI_API_KEY=your-gemini-api-key

# Supabase tables required by ingest.ts:
#   documents  (id uuid pk, slug text unique, title text, language text,
#               source_type text, content text, content_hash text, created_at timestamptz)
#   chunks     (id uuid pk, document_id uuid fk→documents.id, chunk_index int,
#               content text, token_estimate int, embedding vector(768),
#               metadata jsonb, content_hash text)
# Enable pgvector extension and create an ivfflat index on chunks.embedding.
