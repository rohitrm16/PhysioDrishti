{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-scripts",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["scripts/**/*", "lib/**/*"],
  "exclude": ["node_modules", "dist", "src"]
}
